{
  "name": "retouch",
  "version": "0.1.0",
  "description": "An editable mirror of your running app at /rt — Figma-grade edits written back to source deterministically.",
  "license": "MIT",
  "bin": {
    "retouch": "bin/retouch.cjs"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.cjs'",
    "test:e2e": "node test/e2e/run.cjs",
    "test:launch": "node test/launch/verify.cjs",
    "release:local": "node scripts/release.cjs"
  },
  "main": "./src/index.cjs",
  "exports": {
    ".": "./src/index.cjs",
    "./next": "./src/next.cjs",
    "./loader": "./src/loader.cjs"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "magic-string": "^0.30.0",
    "tailwind-merge": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "src/",
    "shell/",
    "scripts/homebrew-formula.cjs",
    "README.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ]
}
